# Copy to .env on the server; docker compose reads it automatically.
# Only the production stack (docker-compose.prod.yml) uses these.

# The address Caddy serves.
#   unset / :80             plain HTTP, the only option for a bare IP address
#   clue-trainer.duckdns.org  a hostname pointing at this machine, which makes
#                           Caddy fetch and renew a Let's Encrypt certificate
SITE_ADDRESS=:80

# Fill the image cache in the background after boot, so that playing never
# waits on the guide site. Images already on disk are skipped, so leaving this
# on costs nothing once the cache is full.
#
# Be aware of where you run it: the guide site rate-limits datacenter
# addresses far harder than residential ones. Measured with the same code,
# 3s apart: ~47 images/hour from an Oracle VM (with escalating blocks) versus
# ~1,080/hour from a home connection. To fill a cache quickly, run it at home
# with WARM_INTERVAL_MS lowered and copy the volume across - see the README
# section "Filling the cache from your own machine".
WARM_CACHE=false
# WARM_CACHE_ALL=false

# Gap between two images while warming, in ms. The default is deliberately
# slow; the warmer doubles it whenever the origin rate-limits it, and eases
# back after a clean run. Try 5000 at home, leave it alone on a server.
# WARM_INTERVAL_MS=30000

# Warming stands aside for this long after any request from a player, in ms.
# WARM_QUIET_MS=60000

# Smallest gap between two image fetches serving a player, in ms.
# IMAGE_MIN_INTERVAL_MS=3000

# JVM options for the backend. The default sizes the heap from the container
# limit, which is right on the 12 GB ARM shape. On the 1 GB micro shape use:
#   JAVA_OPTS=-Xmx256m
# JAVA_OPTS=-XX:MaxRAMPercentage=75
