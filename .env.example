# Copy to .env on the server; docker compose reads it automatically.
# Only the production stack (docker-compose.prod.yml) uses these.

# The address Caddy serves.
#   unset / :80             plain HTTP, the only option for a bare IP address
#   clue-trainer.duckdns.org  a hostname pointing at this machine, which makes
#                           Caddy fetch and renew a Let's Encrypt certificate
SITE_ADDRESS=:80

# Fill the image cache in the background after boot. Off by default, and best
# left that way: plonkit.net's robots.txt allowlists three search engines and
# disallows every other crawler, and enforces it with escalating rate limits.
# Measured, a bulk fetch starts near 3 images/minute and degrades to about
# 30/hour with blocks of up to half an hour.
#
# The game does not need it. It plays from whatever images are cached and grows
# that pool as people play. If you want a complete offline copy, ask the
# guide's authors rather than crawling for it.
WARM_CACHE=false
# WARM_CACHE_ALL=false

# Gap between two images while warming, in ms. The warmer doubles it whenever
# the origin rate-limits it, and eases back after a clean run.
# WARM_INTERVAL_MS=30000

# Warming stands aside for this long after any request from a player, in ms.
# WARM_QUIET_MS=60000

# Smallest gap between two image fetches serving a player, in ms.
# IMAGE_MIN_INTERVAL_MS=3000

# JVM options for the backend. The default sizes the heap from the container
# limit, which is right on the 12 GB ARM shape. On the 1 GB micro shape use:
#   JAVA_OPTS=-Xmx256m
# JAVA_OPTS=-XX:MaxRAMPercentage=75
